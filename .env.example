# Copy to .env and fill in. Real environment variables override values from .env.
# Values here are for `uv run manage.py ...` on the host; compose.yaml overrides DB_HOST/DB_PORT/LM_STUDIO_BASE_URL for the container.

# Django
DJANGO_SECRET_KEY='change-me-to-a-random-50+-char-string'
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (compose service db, published on 127.0.0.1:5433)
DB_NAME=agregator
DB_USER=dev
DB_PASSWORD=dev
DB_HOST=localhost
DB_PORT=5433

# LM Studio local server (Developer -> Local Server). Model IDs exactly as `manage.py llm_check` lists them.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_WORKER_MODEL=qwen/qwen3.5-9b
# Empty = the worker model writes too
LM_STUDIO_WRITER_MODEL=
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# Thinking models (Qwen 3.5+) burn max_tokens on reasoning: none = answer right away. none | low | medium | high
LM_STUDIO_REASONING_EFFORT=none
# One request, seconds: a 27B model offloaded to RAM writes ~3-6 tokens/s
LM_STUDIO_TIMEOUT=600

# Feed collection
COLLECTOR_FULL_TEXT=true
COLLECTOR_MAX_ENTRIES=50

# Pipeline: articles -> events -> facts -> card -> checks -> draft
PIPELINE_WINDOW_DAYS=3
PIPELINE_GROUP_THRESHOLD=0.8
PIPELINE_SINGLE_SOURCE_WAIT_HOURS=6
PIPELINE_MAX_EVENTS=10
PIPELINE_MIN_FACTS=3
# Load/unload models through the lms CLI (one big model in VRAM at a time); false = leave it to LM Studio JIT
PIPELINE_MANAGE_MODELS=true

# Site publishing API (agregator-backend): ready drafts go there (pipeline --stage publish).
# The same key as the backend's PUBLISHING_API_KEY. Empty = drafts wait in the outbox, nothing is sent.
PUBLISHING_URL=http://localhost:8002
PUBLISHING_API_KEY=
PUBLISHING_TIMEOUT=30
PUBLISHING_MAX_ATTEMPTS=10
